// Stage 10: Dr. Demos in his hover-pod. Hit the pod with wires to damage it;
// it drops orbs faster as its health falls.
LevelDef(
    name: "Demos Fortress",
    time_limit: 240.0,
    speed: 1.0,
    weapon: DoubleWire,
    drop_chance: 0.25,
    drop_table: [Shield, Freeze, Slow, Bonus, Double, Anchor],
    theme: (sky_top: "#1a0033", sky_bottom: "#ff3c6e", accent: "#ff3c6e", decor: Fortress),
    orbs: [],
    boss: Some((
        hp: 40,
        spawn_interval: 5.5,
        spawn_tiers: [L, M, L, XL, M],
        speed: 1.0,
        max_orbs: 10,
    )),
)
